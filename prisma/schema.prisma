// Stars Giveaway Bot — Prisma schema (uses "giveaway" schema in shared Supabase DB)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["giveaway"]
}

model User {
  id                  String   @id @default(cuid())
  tgId                String   @unique
  username            String?
  firstName           String?
  lastName            String?
  isAdmin             Boolean  @default(false)
  isBanned            Boolean  @default(false)
  totalWins           Int      @default(0)
  totalParticipations Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ownedGiveaways  Giveaway[]    @relation("GiveawayOwner")
  participations  Participant[]
  wins            Winner[]
  sessions        Session[]

  @@schema("giveaway")
}

model Giveaway {
  id              String   @id @default(cuid())
  title           String
  description     String
  requirements    String
  winnersCount    Int
  endType         String
  endsAt          DateTime?
  mediaType       String?
  mediaFileId     String?
  channelUsername String
  channelId       String?
  messageTgId     String?
  totalTickets    Int      @default(0)
  status          String   @default("active")
  ownerTgId       String
  createdAt       DateTime @default(now())
  endedAt         DateTime?

  owner           User     @relation("GiveawayOwner", fields: [ownerTgId], references: [tgId])
  participants    Participant[]
  winners         Winner[]

  @@index([status, endsAt])
  @@index([ownerTgId])
  @@index([channelUsername])
  @@schema("giveaway")
}

model Participant {
  id          String   @id @default(cuid())
  giveawayId  String
  tgId        String
  username    String?
  firstName   String?
  createdAt   DateTime @default(now())

  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [tgId], references: [tgId])

  @@unique([giveawayId, tgId])
  @@index([giveawayId])
  @@index([tgId])
  @@schema("giveaway")
}

model Winner {
  id          String   @id @default(cuid())
  giveawayId  String
  tgId        String
  username    String?
  firstName   String?
  place       Int
  createdAt   DateTime @default(now())

  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [tgId], references: [tgId])

  @@index([giveawayId])
  @@index([tgId])
  @@schema("giveaway")
}

model Session {
  id          String   @id @default(cuid())
  tgId        String   @unique
  step        String
  data        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [tgId], references: [tgId], onDelete: Cascade)

  @@schema("giveaway")
}
